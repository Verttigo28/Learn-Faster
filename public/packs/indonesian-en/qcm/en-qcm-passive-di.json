  "questions": [
    {
      "id": "1",
      "prompt": "Fill in the blank: \"Buku itu ___ oleh Ani.\" (That book is read by Ani.)",
      "choices": [
        {
          "id": "a",
          "text": "terbacakan",
          "correct": false
        },
        {
          "id": "b",
          "text": "baca-baca",
          "correct": false
        },
        {
          "id": "c",
          "text": "membaca",
          "correct": false
        },
        {
          "id": "d",
          "text": "dibaca",
          "correct": true
        }
      ],
      "explanation": "Passive: di- + root, giving dibaca.",
      "tags": [
        "grammar",
        "passive",
        "a2"
      ]
    },
    {
      "id": "2",
      "prompt": "Put into the passive: \"Ali membeli mobil itu.\"",
      "choices": [
        {
          "id": "a",
          "text": "Mobil itu dibelikan Ali oleh.",
          "correct": false
        },
        {
          "id": "b",
          "text": "Ali dibeli mobil itu.",
          "correct": false
        },
        {
          "id": "c",
          "text": "Mobil itu membeli Ali.",
          "correct": false
        },
        {
          "id": "d",
          "text": "Mobil itu dibeli oleh Ali.",
          "correct": true
        }
      ],
      "explanation": "The object becomes the subject, the verb takes di-, and the agent is introduced by \"oleh\".",
      "tags": [
        "grammar",
        "passive",
        "a2"
      ]
    },
    {
      "id": "3",
